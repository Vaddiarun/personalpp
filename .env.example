# Public base URL used to build the recipient link that you paste into WhatsApp.
# Local testing on the same machine:
#   NEXT_PUBLIC_BASE_URL=http://localhost:3000
# LAN testing (replace with your machine's Wi-Fi IP, e.g. ipconfig / ifconfig):
#   NEXT_PUBLIC_BASE_URL=http://192.168.1.20:3000
# Real phone testing over the internet (browser geolocation needs HTTPS) — use a tunnel:
#   NEXT_PUBLIC_BASE_URL=https://your-subdomain.trycloudflare.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Database (libSQL / Turso) ---
# PRODUCTION (Vercel and any serverless host): a hosted libSQL database is REQUIRED,
# because the filesystem is read-only. Create one for free:
#   npm i -g @tursodatabase/cli   (or: brew install tursodatabase/tap/turso)
#   turso auth signup
#   turso db create investigatex
#   turso db show investigatex --url          -> TURSO_DATABASE_URL
#   turso db tokens create investigatex       -> TURSO_AUTH_TOKEN
# Then add both as Environment Variables in the Vercel project settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# LOCAL DEV ONLY: with the two vars above left blank, the app uses a local file.
INVESTIGATEX_DB=./data/investigatex.db

# --- Branding on the recipient consent page (all optional) ---
NEXT_PUBLIC_AGENCY_NAME=Karnataka State Police
NEXT_PUBLIC_AGENCY_UNIT=Cyber Crime Investigation Cell
# Single emoji/glyph used as the crest:
NEXT_PUBLIC_AGENCY_EMBLEM=🛡️
# Number the recipient can call to confirm the request is genuine:
NEXT_PUBLIC_AGENCY_VERIFY_PHONE=
# NEXT_PUBLIC_AGENCY_VERIFY_NOTE=...
# NEXT_PUBLIC_AGENCY_PRIVACY_NOTE=...
